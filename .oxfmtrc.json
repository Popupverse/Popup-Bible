{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    ".turbo",
    ".pnpm-store",
    "pnpm-lock.yaml",
    "node_modules",
    "routeTree.gen.ts"
  ],
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react-libs",
        "elementNamePattern": ["react", "react-**"]
      }
    ],
    "partitionByComment": true,
    "sortSideEffects": true,
    "groups": [
      "builtin", // node.js builtin
      "react-libs",
      "external",
      "subpath", // node.js #subpaths
      "internal", // @/*
      "parent",
      "sibling",
      "index",
      "style"
    ],
    "ignoreCase": false
  },
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "tw", "tv"],
    "stylesheet": "./packages/ui/src/global.css"
  }
}
