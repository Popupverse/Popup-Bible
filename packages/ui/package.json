{
  "name": "@popup-bible/ui",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#ui/*": "./src/components/ui/*.tsx",
    "#.storybook/preview": "./.storybook/preview.tsx"
